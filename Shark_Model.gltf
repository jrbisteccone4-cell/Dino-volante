<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Great White Shark 3D Ocean Simulator</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #020c1b;
            font-family: sans-serif;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        /* HUD & Controlli UI Overlay */
        #hud {
            position: absolute;
            top: 15px;
            left: 15px;
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
            pointer-events: none;
            z-index: 10;
        }

        /* Cursore Virtuale (Joystick a Sinistra) */
        #joystick-container {
            position: absolute;
            bottom: 30px;
            left: 30px;
            width: 120px;
            height: 120px;
            background: rgba(255, 255, 255, 0.15);
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            touch-action: none;
            z-index: 10;
        }
        #joystick-knob {
            position: absolute;
            top: 35px;
            left: 35px;
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 50%;
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
        }

        /* Pulsanti d'Azione sulla Destra */
        .btn-action {
            position: absolute;
            width: 75px;
            height: 75px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.5);
            color: white;
            font-weight: bold;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            touch-action: manipulation;
            z-index: 10;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        .btn-action:active {
            transform: scale(0.92);
        }
        #btn-bite {
            bottom: 30px;
            right: 30px;
            background: rgba(220, 53, 69, 0.8);
        }
        #btn-dash {
            bottom: 115px;
            right: 40px;
            background: rgba(255, 193, 7, 0.8);
            color: #000;
        }
    </style>

    <!-- Import Map per Three.js e moduli -->
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/examples/jsm/loaders/GLTFLoader.js": "https://unpkg.com/three@0.160.0/examples/jsm/loaders/GLTFLoader.js"
            }
        }
    </script>
</head>
<body>

    <div id="hud">
        Punti: <span id="score">0</span> | Prede Divorate: <span id="eaten">0</span>
    </div>

    <!-- Tasto 1: Cursore di movimento a sinistra -->
    <div id="joystick-container">
        <div id="joystick-knob"></div>
    </div>

    <!-- Tasto 2: Scatto -->
    <div id="btn-dash" class="btn-action">SCATTO</div>

    <!-- Tasto 3: Mordi e Mangia -->
    <div id="btn-bite" class="btn-action">MORDI</div>

    <script type="module">
        import * as THREE from 'three';
        import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

        // --- 1. SET-UP SCENA & RENDERER (Full HD / Retina) ---
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x021c38);
        scene.fog = new THREE.FogExp2(0x021c38, 0.015); // Effetto foschia acquatica profonda

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        
        const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        document.body.appendChild(renderer.domElement);

        // --- 2. ILLUMINAZIONE MARINA ---
        const ambientLight = new THREE.AmbientLight(0x4080ff, 1.8);
        scene.add(ambientLight);

        const sunLight = new THREE.DirectionalLight(0xffffff, 2.5);
        sunLight.position.set(20, 100, 20);
        scene.add(sunLight);

        // --- 3. FONDALE MARINO TRIDIMENSIONALE CON BARRIERA CORALLINA ---
        const seabedGeo = new THREE.PlaneGeometry(500, 500, 64, 64);
        // Modifica i vertici per creare dune e montagne sottomarine
        const pos = seabedGeo.attributes.position;
        for (let i = 0; i < pos.count; i++) {
            const vx = pos.getX(i);
            const vy = pos.getY(i);
            const z = Math.sin(vx * 0.05) * Math.cos(vy * 0.05) * 3 + Math.sin(vx * 0.01) * 5;
            pos.setZ(i, z);
        }
        seabedGeo.computeVertexNormals();

        const seabedMat = new THREE.MeshStandardMaterial({
            color: 0x2c4c38,
            roughness: 0.9,
            metalness: 0.1
        });
        const seabed = new THREE.Mesh(seabedGeo, seabedMat);
        seabed.rotation.x = -Math.PI / 2;
        seabed.position.y = -40;
        scene.add(seabed);

        // Generazione di alghe, coralli e rocce sul fondale
        const coralGeo = new THREE.ConeGeometry(0.8, 4, 5);
        const coralMat = new THREE.MeshStandardMaterial({ color: 0xff4081, roughness: 0.6 });
        const coralInstanced = new THREE.InstancedMesh(coralGeo, coralMat, 200);
        const dummy = new THREE.Object3D();

        for (let i = 0; i < 200; i++) {
            dummy.position.set(
                (Math.random() - 0.5) * 400,
                -39,
                (Math.random() - 0.5) * 400
            );
            const s = Math.random() * 2 + 0.5;
            dummy.scale.set(s, s, s);
            dummy.rotation.y = Math.random() * Math.PI;
            dummy.updateMatrix();
            coralInstanced.setMatrixAt(i, dummy.matrix);
        }
        scene.add(coralInstanced);

        // --- 4. FAUNA MARINA (Pesci, Tartarughe, Balene, ecc.) ---
        const preyList = [];
        const preyColors = [0xff9800, 0x00bcd4, 0xe91e63, 0x9c27b0, 0x4caf50, 0xffeb3b];

        function createPreyCluster() {
            const fishGroup = new THREE.Group();
            const bodyGeo = new THREE.ConeGeometry(0.4, 1.2, 6);
            bodyGeo.rotateX(Math.PI / 2);

            for (let i = 0; i < 120; i++) {
                const mat = new THREE.MeshStandardMaterial({
                    color: preyColors[Math.floor(Math.random() * preyColors.length)],
                    roughness: 0.3
                });
                const fish = new THREE.Mesh(bodyGeo, mat);
                
                fish.position.set(
                    (Math.random() - 0.5) * 300,
                    Math.random() * 30 - 30,
                    (Math.random() - 0.5) * 300
                );
                
                fish.userData = {
                    speed: Math.random() * 0.08 + 0.04,
                    rotSpeed: (Math.random() - 0.5) * 0.02
                };

                scene.add(fish);
                preyList.push(fish);
            }
        }
        createPreyCluster();

        // --- 5. CARICAMENTO MODELLO SQUALO 3D CON TEXTURE E ANIMAZIONI ---
        let shark = new THREE.Group(); // Contenitore fallback
        let mixer = null;
        let animationsMap = {};
        const clock = new THREE.Clock();

        const textureLoader = new THREE.TextureLoader();
        const loadTex = (path, isSRGB = false) => textureLoader.load(path, (t) => { if(isSRGB) t.colorSpace = THREE.SRGBColorSpace; });

        const baseColorMap = loadTex('./gltf_embedded_0.jpg', true);
        const normalMap = loadTex('./gltf_embedded_1.png');
        const roughnessMap = loadTex('./gltf_embedded_2.jpg');
        const metallicMap = loadTex('./gltf_embedded_3@channels=R.jpg');

        const loader = new GLTFLoader();
        loader.load(
            './shark_model.gltf',
            (gltf) => {
                shark = gltf.scene;

                // Applicazione texture e materiale PBR avanzato
                shark.traverse((child) => {
                    if (child.isMesh) {
                        child.material = new THREE.MeshStandardMaterial({
                            map: baseColorMap,
                            normalMap: normalMap,
                            roughnessMap: roughnessMap,
                            metalnessMap: metallicMap,
                            roughness: 0.3,
                            metalness: 0.2
                        });
                    }
                });

                shark.scale.set(1.2, 1.2, 1.2);
                scene.add(shark);

                // Configurazione delle 3 animazioni ('swimming', 'circling', 'bite')
                if (gltf.animations && gltf.animations.length > 0) {
                    mixer = new THREE.AnimationMixer(shark);
                    gltf.animations.forEach((clip) => {
                        animationsMap[clip.name.toLowerCase()] = mixer.clipAction(clip);
                    });

                    // Avvia di default l'animazione di nuoto ('swimming')[cite: 1]
                    if (animationsMap['swimming']) {
                        animationsMap['swimming'].play();
                    } else if (gltf.animations[0]) {
                        mixer.clipAction(gltf.animations[0]).play();
                    }
                }
            },
            undefined,
            (err) => {
                console.warn('Modello GLTF non trovato. Uso di uno squalo procedurale 3D di riserva.');
                // Fallback 3D se il file .gltf non è presente
                const geo = new THREE.ConeGeometry(1, 4, 8);
                geo.rotateX(Math.PI / 2);
                const mat = new THREE.MeshStandardMaterial({ color: 0x708090, roughness: 0.2 });
                shark = new THREE.Mesh(geo, mat);
                scene.add(shark);
            }
        );

        // --- 6. SISTEMA DI CONTROLLO (JOYSTICK, BOTTONI & VISUALE 360°) ---
        let moveInput = { x: 0, y: 0 };
        let isDashing = false;
        let score = 0;
        let eatenCount = 0;

        // Tasto 1: Joystick / Cursore Virtuale
        const joystickContainer = document.getElementById('joystick-container');
        const joystickKnob = document.getElementById('joystick-knob');
        let joystickActive = false;
        let joystickCenter = { x: 0, y: 0 };

        function handleJoystickStart(e) {
            joystickActive = true;
            const touch = e.touches ? e.touches[0] : e;
            const rect = joystickContainer.getBoundingClientRect();
            joystickCenter = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
            handleJoystickMove(e);
        }

        function handleJoystickMove(e) {
            if (!joystickActive) return;
            const touch = e.touches ? e.touches[0] : e;
            const dx = touch.clientX - joystickCenter.x;
            const dy = touch.clientY - joystickCenter.y;
            const dist = Math.min(Math.hypot(dx, dy), 45);
            const angle = Math.atan2(dy, dx);

            const knobX = Math.cos(angle) * dist;
            const knobY = Math.sin(angle) * dist;

            joystickKnob.style.transform = `translate(${knobX}px, ${knobY}px)`;
            moveInput.x = knobX / 45;
            moveInput.y = knobY / 45;
        }

        function handleJoystickEnd() {
            joystickActive = false;
            joystickKnob.style.transform = `translate(0px, 0px)`;
            moveInput = { x: 0, y: 0 };
        }

        joystickContainer.addEventListener('touchstart', handleJoystickStart);
        window.addEventListener('touchmove', handleJoystickMove);
        window.addEventListener('touchend', handleJoystickEnd);
        joystickContainer.addEventListener('mousedown', handleJoystickStart);
        window.addEventListener('mousemove', handleJoystickMove);
        window.addEventListener('mouseup', handleJoystickEnd);

        // Controllo Tastiera (W A S D / Frecce) per PC
        window.addEventListener('keydown', (e) => {
            if (e.key === 'w' || e.key === 'ArrowUp') moveInput.y = -1;
            if (e.key === 's' || e.key === 'ArrowDown') moveInput.y = 1;
            if (e.key === 'a' || e.key === 'ArrowLeft') moveInput.x = -1;
            if (e.key === 'd' || e.key === 'ArrowRight') moveInput.x = 1;
            if (e.key === 'Shift') triggerDash();
            if (e.key === ' ') triggerBite();
        });
        window.addEventListener('keyup', (e) => {
            if (['w','s','ArrowUp','ArrowDown'].includes(e.key)) moveInput.y = 0;
            if (['a','d','ArrowLeft','ArrowRight'].includes(e.key)) moveInput.x = 0;
        });

        // Visuale a 360 Gradi (Drag sul resto dello schermo)
        let isRotatingCam = false;
        let previousTouchPos = { x: 0, y: 0 };
        let cameraAngleYaw = 0;
        let cameraAnglePitch = 0.2;

        window.addEventListener('pointerdown', (e) => {
            if (e.clientX > window.innerWidth / 3 || e.clientY < window.innerHeight / 2) {
                isRotatingCam = true;
                previousTouchPos = { x: e.clientX, y: e.clientY };
            }
        });

        window.addEventListener('pointermove', (e) => {
            if (!isRotatingCam) return;
            const deltaX = e.clientX - previousTouchPos.x;
            const deltaY = e.clientY - previousTouchPos.y;

            cameraAngleYaw -= deltaX * 0.005;
            cameraAnglePitch = Math.max(-0.5, Math.min(0.8, cameraAnglePitch + deltaY * 0.005));

            previousTouchPos = { x: e.clientX, y: e.clientY };
        });

        window.addEventListener('pointerup', () => isRotatingCam = false);

        // Tasto 2: Scatto
        function triggerDash() {
            if (isDashing) return;
            isDashing = true;
            setTimeout(() => isDashing = false, 1200);
        }
        document.getElementById('btn-dash').addEventListener('touchstart', (e) => { e.preventDefault(); triggerDash(); });
        document.getElementById('btn-dash').addEventListener('click', triggerDash);

        // Tasto 3: Mordi e Mangia
        function triggerBite() {
            // Esegue l'animazione di morso ('bite')[cite: 1]
            if (animationsMap['bite']) {
                const biteAction = animationsMap['bite'];
                biteAction.reset().setLoop(THREE.LoopOnce, 1).play();
                if (animationsMap['swimming']) {
                    setTimeout(() => animationsMap['swimming'].play(), 600);
                }
            }

            // Calcolo collisione morso con le prede vicine alla bocca
            const mouthPos = shark.position.clone().add(
                new THREE.Vector3(0, 0, 2).applyQuaternion(shark.quaternion)
            );

            for (let i = preyList.length - 1; i >= 0; i--) {
                const prey = preyList[i];
                if (prey.position.distanceTo(mouthPos) < 4.5) {
                    scene.remove(prey);
                    preyList.splice(i, 1);
                    score += 100;
                    eatenCount++;
                    document.getElementById('score').innerText = score;
                    document.getElementById('eaten').innerText = eatenCount;
                }
            }
        }
        document.getElementById('btn-bite').addEventListener('touchstart', (e) => { e.preventDefault(); triggerBite(); });
        document.getElementById('btn-bite').addEventListener('click', triggerBite);

        // --- 7. GAME LOOP & ANIMAZIONI ---
        function animate() {
            requestAnimationFrame(animate);
            const delta = clock.getDelta();

            // Aggiorna mixer animazione dello squalo[cite: 1]
            if (mixer) mixer.update(delta);

            // Movimento dello Squalo basato sul Cursore
            const currentSpeed = (isDashing ? 0.45 : 0.2);

            if (Math.abs(moveInput.x) > 0.05 || Math.abs(moveInput.y) > 0.05) {
                shark.rotation.y -= moveInput.x * 0.04;

                // Nuoto in avanti/indietro e quota Y
                shark.translateZ(moveInput.y * currentSpeed);
                shark.position.y = Math.max(-38, Math.min(10, shark.position.y - moveInput.y * 0.08));

                // Oscillazione naturale del corpo del vero squalo
                shark.rotation.z = Math.sin(clock.getElapsedTime() * 5) * 0.05;
            }

            // Inseguimento e posizionamento Telecamera a 360°
            const camDistance = 9;
            const camX = shark.position.x + camDistance * Math.sin(cameraAngleYaw) * Math.cos(cameraAnglePitch);
            const camY = shark.position.y + camDistance * Math.sin(cameraAnglePitch) + 2;
            const camZ = shark.position.z + camDistance * Math.cos(cameraAngleYaw) * Math.cos(cameraAnglePitch);

            camera.position.set(camX, camY, camZ);
            camera.lookAt(shark.position.x, shark.position.y + 0.8, shark.position.z);

            // Movimento autonomo IA delle prede
            preyList.forEach((prey) => {
                prey.translateX(prey.userData.speed);
                prey.rotation.y += prey.userData.rotSpeed;
            });

            renderer.render(scene, camera);
        }

        // Ridimensionamento Schermo automatico
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        animate();
    </script>
</body>
</html>
